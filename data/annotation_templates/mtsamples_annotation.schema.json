{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faithfulmed.example/schemas/mtsamples_annotation.schema.json",
  "title": "FaithfulMed MTSamples annotation",
  "description": "Structural validation for independent and adjudicated attribution annotations. This schema does not validate medical correctness.",
  "oneOf": [
    {
      "$ref": "#/$defs/independentAnnotation"
    },
    {
      "$ref": "#/$defs/adjudicatedAnnotation"
    }
  ],
  "$defs": {
    "contentType": {
      "type": "string",
      "enum": [
        "lab_values",
        "medications",
        "procedures",
        "instructions"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "fact_text",
        "fact_type",
        "source_evidence"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_text": {
          "type": "string",
          "minLength": 1,
          "description": "A self-contained statement of one fact. Self-containment requires human review."
        },
        "fact_type": {
          "type": "string",
          "enum": [
            "diagnosis",
            "medication",
            "lab_value",
            "procedure",
            "instruction"
          ]
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "One or more exact supporting spans from source_text.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commonProperties": {
      "type": "object",
      "required": [
        "example_id",
        "source_url",
        "primary_content_type",
        "selection_mode",
        "source_text",
        "facts"
      ],
      "properties": {
        "example_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "primary_content_type": {
          "$ref": "#/$defs/contentType"
        },
        "selection_mode": {
          "type": "string",
          "enum": [
            "entire_report",
            "self_contained_passage"
          ]
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Fact IDs must be unique within the array; validate_annotations.py enforces property-level uniqueness.",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "independentAnnotation": {
      "allOf": [
        {
          "$ref": "#/$defs/commonProperties"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "example_id",
            "source_url",
            "primary_content_type",
            "selection_mode",
            "source_text",
            "facts",
            "annotation_notes"
          ],
          "properties": {
            "example_id": true,
            "source_url": true,
            "primary_content_type": true,
            "selection_mode": true,
            "source_text": true,
            "facts": true,
            "annotator_id": {
              "type": "string",
              "minLength": 1,
              "description": "Optional in the template; recommended for saved independent annotations."
            },
            "annotation_notes": {
              "type": "string"
            }
          }
        }
      ]
    },
    "adjudicatedAnnotation": {
      "allOf": [
        {
          "$ref": "#/$defs/commonProperties"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "example_id",
            "source_url",
            "primary_content_type",
            "selection_mode",
            "source_text",
            "facts",
            "adjudication_notes"
          ],
          "properties": {
            "example_id": true,
            "source_url": true,
            "primary_content_type": true,
            "selection_mode": true,
            "source_text": true,
            "facts": true,
            "adjudication_notes": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
