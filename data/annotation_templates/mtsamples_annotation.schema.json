{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faithfulmed.example/schemas/mtsamples_annotation.schema.json",
  "title": "FaithfulMed MTSamples annotation",
  "description": "Structural validation for independent and adjudicated attribution annotations. This schema does not validate medical correctness.",
  "oneOf": [
    {
      "$ref": "#/$defs/independentAnnotation"
    },
    {
      "$ref": "#/$defs/adjudicatedAnnotation"
    }
  ],
  "$defs": {
    "contentType": {
      "type": "string",
      "enum": [
        "lab_values",
        "medications",
        "procedures",
        "instructions"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "fact_text",
        "fact_type",
        "source_sentence"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_text": {
          "type": "string",
          "minLength": 1,
          "description": "A self-contained statement of one fact. Self-containment requires human review."
        },
        "fact_type": {
          "type": "string",
          "enum": [
            "diagnosis",
            "medication",
            "lab_value",
            "procedure",
            "instruction"
          ]
        },
        "source_sentence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceMetadata": {
      "type": "object",
      "required": [
        "example_id",
        "source_url",
        "website_specialty",
        "split",
        "primary_content_type",
        "secondary_content_types",
        "selection_mode",
        "source_text"
      ],
      "properties": {
        "example_id": {
          "type": "string",
          "minLength": 1
        },
        "source_dataset": {
          "const": "MTSamples"
        },
        "parent_document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "website_specialty": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "enum": [
            "scratch",
            "dev",
            "test"
          ]
        },
        "primary_content_type": {
          "$ref": "#/$defs/contentType"
        },
        "secondary_content_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentType"
          }
        },
        "selection_mode": {
          "type": "string",
          "enum": [
            "entire_report",
            "self_contained_passage"
          ]
        },
        "included_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "independentAnnotation": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceMetadata"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "example_id",
            "source_url",
            "website_specialty",
            "split",
            "primary_content_type",
            "secondary_content_types",
            "selection_mode",
            "source_text",
            "annotator_id",
            "facts",
            "annotation_notes",
            "needs_adjudication"
          ],
          "properties": {
            "example_id": true,
            "source_url": true,
            "website_specialty": true,
            "split": true,
            "primary_content_type": true,
            "secondary_content_types": true,
            "selection_mode": true,
            "source_text": true,
            "annotator_id": {
              "type": "string",
              "minLength": 1
            },
            "facts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "description": "Fact IDs must be unique within the array; validate_annotations.py enforces property-level uniqueness.",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "annotation_notes": {
              "type": "string"
            },
            "needs_adjudication": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "adjudicatedAnnotation": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceMetadata"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "example_id",
            "source_dataset",
            "parent_document_id",
            "source_url",
            "website_specialty",
            "split",
            "primary_content_type",
            "secondary_content_types",
            "selection_mode",
            "included_sections",
            "source_text",
            "independent_annotators",
            "adjudicator_id",
            "annotation_version",
            "frozen",
            "gold_facts",
            "adjudication_notes"
          ],
          "properties": {
            "example_id": true,
            "source_dataset": true,
            "parent_document_id": true,
            "source_url": true,
            "website_specialty": true,
            "split": true,
            "primary_content_type": true,
            "secondary_content_types": true,
            "selection_mode": true,
            "included_sections": true,
            "source_text": true,
            "independent_annotators": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "adjudicator_id": {
              "type": "string",
              "minLength": 1
            },
            "annotation_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "frozen": {
              "type": "boolean"
            },
            "gold_facts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "description": "Fact IDs must be unique within the array; validate_annotations.py enforces property-level uniqueness.",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "adjudication_notes": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "split": {
                    "const": "test"
                  }
                },
                "required": [
                  "split"
                ]
              },
              "then": {
                "properties": {
                  "frozen": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
